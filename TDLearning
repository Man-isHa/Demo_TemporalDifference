  pPlay:()=>{pr.play=!pr.play;renderPred();if(pr.play){clearTimeout(pTimer);pPlayTick();}},
  pFinish:()=>{pr.play=false;if(pr.s===null)prStep();let k=0;while(pr.s!==null&&k<5000){prStep();k++;}renderPred();},
  pReset:()=>{prReset();renderPred();},
  palpha:i=>{pAlpha=PALPHA[+i];runPexp();enter();},
  pgust:i=>{pGust=!!+i;runPexp();enter();},
  pexp:()=>{runPexp();enter();},
  sAlg:k=>{stepAlg=k;enter();},
  sStep:n=>{const g=getStep();for(let i=0;i<+n;i++)agentStep(g);enter();},
  sEp:()=>{const g=getStep();let k=0;do{agentStep(g);k++;}while(g.s!==null&&k<20000);enter();},
  sReset:()=>{delete stepAg[stepAlg];enter();},
  race:()=>{raceRun=!raceRun;renderRace();if(raceRun)requestAnimationFrame(raceTick);},
  speed:n=>{raceSpeed=+n;},
  raceJump:()=>{raceRun=false;raceAdvance(TMAX);enter();},
  raceReset:()=>{raceReset();enter();},
  raceNew:()=>{raceReset();raceAdvance(TMAX);enter();},
  cplay:a=>cpMove(+a),
  cplayReset:()=>{cpReset();renderCP();},
  clRun:()=>{cl.run=!cl.run;renderCL();if(cl.run)requestAnimationFrame(clTick);},
  clSpeed:n=>{cl.speed=+n;},
  clAdd:n=>{cl.run=false;for(const g of cl.ags){const target=g.ep+(+n);while(g.ep<target)cEpisode(g);}enter();},
  clReset:()=>{clReset();enter();},
  cfEps:i=>{cfEps=CF_EPS[+i];enter();},
  cfig:()=>{$('#t-cfig').innerHTML='<p class="sm muted">Training…</p>';setTimeout(()=>{runCfig();enter();},30);},
  raceMore:()=>{raceRun=false;TMAX=race.ags[0].t+8000;raceAdvance(8000);enter();},
  qsZoom:()=>{qsZoom=!qsZoom;enter();}
};
document.addEventListener('click',e=>{const b=e.target.closest('[data-do]');if(!b)return;const [a,x]=b.dataset.do.split(':');ACT[a]&&ACT[a](x);});

/* ================= navigation ================= */
const slides=[...document.querySelectorAll('.slide')];let cur=0;
function enter(){const fn=S[slides[cur].id];fn&&fn();}
function go(i,back){
  i=Math.max(0,Math.min(slides.length-1,i));
  slides[cur].classList.remove('active');cur=i;slides[cur].classList.add('active');
  slides[cur].querySelectorAll('.frag').forEach(fr=>fr.classList.toggle('show',!!back));
  raceRun=false;pr.play=false;if(cl)cl.run=false;
  enter();
  $('#cnt').textContent=`${cur+1} / ${slides.length}`;
  $('#barfill').style.width=((cur+1)/slides.length*100)+'%';
  try{history.replaceState(null,'','#'+(cur+1));}catch(e){}
}
function next(){const fr=slides[cur].querySelector('.frag:not(.show)');if(fr){fr.classList.add('show');return;}go(cur+1);}
function prev(){go(cur-1,true);}
$('#prev').onclick=prev;$('#next').onclick=next;
document.addEventListener('keydown',e=>{
  if(['ArrowRight','PageDown'].includes(e.key)){e.preventDefault();next();}
  if(['ArrowLeft','PageUp'].includes(e.key)){e.preventDefault();prev();}
  if(slides[cur].id==='s-world'){const m={a:0,s:1,d:2,w:3}[e.key.toLowerCase()];if(m!=null)playMove(m);}
  if(slides[cur].id==='s-cliff'){const m={a:0,s:1,d:2,w:3}[e.key.toLowerCase()];if(m!=null)cpMove(m);}
});
let tx=null;
document.addEventListener('touchstart',e=>{tx=e.touches[0].clientX;},{passive:true});
document.addEventListener('touchend',e=>{if(tx==null)return;const dx=e.changedTouches[0].clientX-tx;if(Math.abs(dx)>70)(dx<0?next:prev)();tx=null;});
function fit(){const vp=$('#vp'),k=Math.min(vp.clientWidth/1600,vp.clientHeight/900);$('#stage').style.transform=`translate(-50%,-50%) scale(${k})`;}
window.addEventListener('resize',fit);fit();
try{matchMedia('(prefers-color-scheme: dark)').addEventListener('change',()=>enter());}catch(e){}
const h0=parseInt((location.hash||'').slice(1),10);
slides[0].classList.add('active');
go(isNaN(h0)?0:h0-1);
</script>
