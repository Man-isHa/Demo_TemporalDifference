function mkC(alg,seed,eps=0.1){return {alg,eps,rnd:mul(seed),Q:Array.from({length:CN},()=>[0,0,0,0]),N:Array.from({length:CN},()=>[0,0,0,0]),s:null,a:null,ep:0,ret:0,falls:0,trail:new Set(),rets:[],fallsArr:[],t:0,fellAt:null};}
const cEg=(g,s)=>g.rnd()<g.eps?Math.floor(g.rnd()*4):argmaxR(g.Q[s],g.rnd);
function cAgentStep(g){
  if(g.s===null){g.s=CS;g.a=cEg(g,CS);g.ret=0;g.falls=0;g.trail=new Set([CS]);}
  const s=g.s,a=g.a,o=cStep(s,a);g.t++;g.ret+=o.r;g.fellAt=o.fell?o.hit:null;if(o.fell)g.falls++;g.trail.add(o.s2);
