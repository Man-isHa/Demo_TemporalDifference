<script>
/* ================= environment ================= */
const $=q=>document.querySelector(q);
const W=10,H=7,NS=70,WIND=[0,0,0,1,1,1,2,2,1,0],START=30,GOAL=37;
const DR=[[0,-1],[1,0],[0,1],[-1,0]],ARW=['←','↓','→','↑'],ATEX=['\\leftarrow','\\downarrow','\\rightarrow','\\uparrow'],ACTS=[0,1,2,3];
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
function envStep(s,a,dw=0){let r=Math.floor(s/W),c=s%W;let w=WIND[c];if(w)w+=dw;r=clamp(r+DR[a][0]-w,0,H-1);c=clamp(c+DR[a][1],0,W-1);return r*W+c;}
const STATES=[...Array(NS).keys()].filter(s=>s!==GOAL);
// optimal values (deterministic)
const VSTAR=(()=>{const V=new Array(NS).fill(0);for(let it=0;it<200;it++)for(const s of STATES)V[s]=Math.max(...ACTS.map(a=>-1+V[envStep(s,a)]));return V;})();
const OPTA=s=>ACTS.filter(a=>-1+VSTAR[envStep(s,a)]===VSTAR[s]);
const PI=VSTAR.map((v,s)=>s===GOAL?-1:[2,1,3,0].find(a=>OPTA(s).includes(a)));
const OPTPATH=(()=>{const m=new Map();let s=START,k=0;while(s!==GOAL&&k<40){m.set(s,k);s=envStep(s,PI[s]);k++;}m.set(GOAL,k);return m;})();
const EPS=0.1,ALPHA=0.5;
const VEPS_S=(()=>{const V=new Array(NS).fill(0);for(let it=0;it<5000;it++)for(const s of STATES){const o=OPTA(s);V[s]=ACTS.reduce((t,a)=>t+(EPS/4+(o.includes(a)?(1-EPS)/o.length:0))*(-1+V[envStep(s,a)]),0);}return V[START];})();

/* ================= rng & helpers ================= */
function mul(a){return()=>{a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
let seedCounter=101;
const newQ=()=>Array.from({length:NS},()=>[0,0,0,0]);
function argmaxR(q,rnd){const m=Math.max(...q);const b=ACTS.filter(a=>q[a]===m);return b[Math.floor(rnd()*b.length)];}
const eg=(Q,s,rnd)=>rnd()<EPS?Math.floor(rnd()*4):argmaxR(Q[s],rnd);
const greedyD=q=>{let b=0;for(let a=1;a<4;a++)if(q[a]>q[b])b=a;return b;};
const allEq=q=>q.every(v=>v===q[0]);
const f=(v,d=2)=>{if(Math.abs(v)<0.5*10**-d)v=0;return (v<0?'−':'')+Math.abs(v).toFixed(d);};
const ft=(v,d=2)=>{if(Math.abs(v)<0.5*10**-d)v=0;return v.toFixed(d);};
const tp=(v,d=2)=>v<0?`(${ft(v,d)})`:ft(v,d);
const fq=v=>Math.abs(v)<9.95?f(v,1):f(v,0);
const stat=(k,v)=>`<span>${k}</span><b>${v}</b>`;

/* ================= mathjax queue ================= */
const pend=new Set();let mq=Promise.resolve();
function typeset(el){if(!el)return;if(!MJ_READY){pend.add(el);return;}mq=mq.then(()=>{MathJax.typesetClear([el]);return MathJax.typesetPromise([el]);}).catch(e=>console.warn(e));}
function flushTypeset(){const a=[...pend];pend.clear();a.forEach(typeset);}

/* ================= grid ================= */
const TRI=['0,0 50,50 0,100','0,100 50,50 100,100','100,0 50,50 100,100','0,0 50,50 100,0'];
function cfill(v,sc){const a=(Math.min(1,Math.abs(v)/sc)*0.82+0.06).toFixed(3);return `fill:rgba(var(--cost),${a})`;}
function ctint(v,sc){const a=(Math.min(1,Math.abs(v)/sc)*0.7).toFixed(3);const c=`rgba(var(--cost),${a})`;return `background-image:linear-gradient(${c},${c})`;}
function gridW(o={}){
  const cs=o.cell||60,gp=cs<50?3:4,sc=o.scale||25;
  let h=`<div class="wg" style="--cs:${cs}px;--gp:${gp}px"><div class="grid" style="grid-template-columns:repeat(${W},var(--cs))">`;
  for(let s=0;s<NS;s++){
    const c=s%W;let cls='cell'+(s===GOAL?' goal':s===START?' start':WIND[c]?' windy':'');
    if(o.trail&&o.trail.has(s))cls+=' trail';
    if(o.path&&o.path.has(s))cls+=' onpath';
    if(o.sel===s)cls+=' sel';
    let style='',inner='';
    if(s===GOAL)inner=`<span class="big">G</span>`;
    else{
      if(s===START)inner+=(o.Q||o.values||(o.path&&o.path.has(s)))?`<span class="st">S</span>`:`<span class="big" style="color:var(--accent)">S</span>`;
      if(o.Q){
        const q=o.Q[s],n=o.N?o.N[s]:null;
        inner+=`<svg class="tri" viewBox="0 0 100 100" preserveAspectRatio="none">${TRI.map((p,a)=>`<polygon points="${p}" style="${n&&!n[a]?'fill:url(#hatch)':cfill(q[a],sc)}"/>`).join('')}</svg>`;
        if(o.path&&o.path.has(s))inner+=`<span class="disc">${o.path.get(s)}</span>`;
        else if(!allEq(q)&&o.arrows!==false)inner+=`<span class="disc">${ARW[greedyD(q)]}</span>`;
        if(o.num&&!(n&&n.every(x=>!x)))inner+=`<span class="qn">${fq(Math.max(...q))}</span>`;
      }else if(o.values){
        style=ctint(o.values[s],sc);
        if(o.vshow?o.vshow(s):true)inner+=`<span class="val">${o.dec===0?f(o.values[s],0):fq(o.values[s])}</span>`;
      }else if(o.path&&o.path.has(s))inner+=`<span class="pn">${o.path.get(s)}</span>`;
    }
    if(s===GOAL&&o.path&&o.path.has(s))inner+='';
    if(o.agent===s)inner+=`<span class="agent"></span>`;
    h+=`<div class="${cls}" style="${style}">${inner}</div>`;
  }
  h+='</div>';
  if(o.wind!==false)h+=`<div class="windrow" style="grid-template-columns:repeat(${W},var(--cs))">${WIND.map(w=>w?`<span>↑${w}</span>`:`<span class="z">0</span>`).join('')}</div>`;
  return h+'</div>';
}

/* ================= chart ================= */
function niceStep(x){const p=10**Math.floor(Math.log10(Math.max(x,1e-9)));const m=x/p;return (m<1.5?1:m<3.5?2:m<7.5?5:10)*p;}
function drawChart(cv,o){
  const {w,h,series}=o,dpr=Math.max(2,window.devicePixelRatio||1);
  cv.width=w*dpr;cv.height=h*dpr;cv.style.width=w+'px';cv.style.height=h+'px';
  const c=cv.getContext('2d');c.setTransform(dpr,0,0,dpr,0,0);c.clearRect(0,0,w,h);
  const cs=getComputedStyle(document.documentElement),V=n=>cs.getPropertyValue(n).trim();
  const L=84,R=34,T=12,B=52,pw=w-L-R,ph=h-T-B;
  let x0=Infinity,x1=-Infinity,lo=Infinity,hi=-Infinity;
  series.forEach(s=>{if(s.pts)s.pts.forEach(([x,y])=>{x0=Math.min(x0,x);x1=Math.max(x1,x);lo=Math.min(lo,y);hi=Math.max(hi,y);});if(s.h!=null){lo=Math.min(lo,s.h);hi=Math.max(hi,s.h);}});
  if(!isFinite(x0)){x0=0;x1=1;}
  if(o.xmin!=null)x0=o.xmin;if(o.xmax!=null)x1=Math.max(x1,o.xmax);if(o.ymin!=null)lo=o.ymin;if(o.ymax!=null)hi=o.ymax;
  if(x1<=x0)x1=x0+1;if(!isFinite(lo)){lo=0;hi=1;}if(hi-lo<1e-6){hi+=0.5;lo-=0.5;}
  const pad=(hi-lo)*0.06;if(o.ymin==null)lo-=pad;if(o.ymax==null)hi+=pad;
  const X=x=>L+pw*(x-x0)/(x1-x0),Y=v=>T+ph*(1-(v-lo)/(hi-lo));
  c.font="15px 'JetBrains Mono', ui-monospace, monospace";c.lineWidth=1;
  const ys=niceStep((hi-lo)/5);
  for(let v=Math.ceil(lo/ys)*ys;v<=hi;v+=ys){const y=Y(v);c.strokeStyle=V('--line');c.beginPath();c.moveTo(L,y);c.lineTo(L+pw,y);c.stroke();c.fillStyle=V('--muted');c.textAlign='right';c.textBaseline='middle';c.fillText(Math.abs(v)<1e-9?'0':(ys<1?v.toFixed(1):String(Math.round(v))),L-10,y);}
  const xs=niceStep((x1-x0)/6);c.textAlign='center';c.textBaseline='top';c.fillStyle=V('--muted');
  for(let v=Math.ceil(x0/xs)*xs;v<=x1;v+=xs){const x=X(v);c.strokeStyle=V('--line');c.beginPath();c.moveTo(x,T+ph);c.lineTo(x,T+ph+6);c.stroke();c.fillText(v>=1000?v.toLocaleString():String(v),x,T+ph+9);}
  c.font="16px 'Public Sans', system-ui, sans-serif";c.fillText(o.xlab||'',L+pw/2,T+ph+30);
  c.save();c.translate(14,T+ph/2);c.rotate(-Math.PI/2);c.fillText(o.ylab||'',0,-6);c.restore();
  c.save();c.beginPath();c.rect(L,T,pw,ph);c.clip();
  series.forEach(s=>{
    c.strokeStyle=V(s.color);c.lineWidth=s.h!=null?2:2.6;c.setLineDash(s.h!=null?[8,6]:[]);c.beginPath();
    if(s.h!=null){c.moveTo(L,Y(s.h));c.lineTo(L+pw,Y(s.h));}
    else{if(!s.pts.length)return;s.pts.forEach(([x,y],i)=>i?c.lineTo(X(x),Y(y)):c.moveTo(X(x),Y(y)));}
    c.stroke();
  });
  c.restore();c.setLineDash([]);
}
const legend=items=>items.map(([col,lab,dash])=>col?`<span><i class="${dash?'dash':''}" style="background:var(${col});border-color:var(${col})"></i>${lab}</span>`:`<span>${lab}</span>`).join('');

/* ================= slides ================= */
const S={};
S['s-title']=()=>{$('#g-title').innerHTML=gridW({cell:54});};

/* --- play yourself --- */
const pl={s:START,n:0,trail:new Set([START]),msg:'Start at \\(S\\). Reach \\(G\\) in as few steps as you can.'};
function renderPlay(){$('#g-play').innerHTML=gridW({cell:72,trail:pl.trail,agent:pl.s});const o=$('#play-out');o.innerHTML=`Steps: <b>${pl.n}</b> &nbsp; Return: <b>${-pl.n}</b><br>`+pl.msg;typeset(o);}
function playMove(a){if(pl.s===GOAL)return;const c=pl.s%W,w=WIND[c];const s2=envStep(pl.s,a);pl.s=s2;pl.n++;pl.trail.add(s2);
  pl.msg=`You chose \\(${ATEX[a]}\\)`+(w?`; the wind pushed you up ${w}.`:'; no wind in that column.');
  if(s2===GOAL)pl.msg=`Reached \\(G\\) in ${pl.n} steps. Best possible: 15.`;renderPlay();}
S['s-world']=renderPlay;
S['s-opt']=()=>{$('#g-opt').innerHTML=gridW({cell:72,values:VSTAR,dec:0,scale:30,path:OPTPATH});};

/* --- prediction: live --- */
const pP=s=>{const a=PI[s];return ACTS.map(b=>EPS/4+(b===a?1-EPS:0));};
function policyAct(s,rnd){return rnd()<EPS?Math.floor(rnd()*4):PI[s];}
const pr={};
function prReset(){Object.assign(pr,{Vtd:new Array(NS).fill(0),Vmc:new Array(NS).fill(0),s:null,buf:[],trail:new Set(),ep:0,rnd:mul(7),last:null,mcLast:null,play:false});}
prReset();
function prStep(){
  if(pr.s===null){pr.s=START;pr.buf=[];pr.trail=new Set([START]);pr.mcLast=null;}
  const s=pr.s,a=policyAct(s,pr.rnd),s2=envStep(s,a),r=-1,old=pr.Vtd[s],nv=s2===GOAL?0:pr.Vtd[s2];
  const d=r+nv-old;pr.Vtd[s]=old+ALPHA*d;pr.last={s,a,s2,old,nv,d,nw:pr.Vtd[s]};
  pr.buf.push(s);pr.trail.add(s2);
  if(s2===GOAL){let G=0;const T=pr.buf.length;for(let i=T-1;i>=0;i--){G-=1;const x=pr.buf[i];pr.Vmc[x]+=ALPHA*(G-pr.Vmc[x]);}pr.ep++;pr.mcLast={T,s0:START,G0:-T};pr.s=null;}else pr.s=s2;
}
function renderPred(){
  const seen=new Set();STATES.forEach(s=>{if(pr.Vtd[s]!==0||pr.Vmc[s]!==0)seen.add(s);});
  const sel=pr.last?pr.last.s:null,agent=pr.s===null?(pr.last?GOAL:START):pr.s;
  const base={cell:54,scale:25,trail:pr.trail,agent,wind:true,vshow:s=>seen.has(s)};
  $('#g-ptd').innerHTML=gridW({...base,values:pr.Vtd,sel});
  $('#g-pmc').innerHTML=gridW({...base,values:pr.Vmc,sel:null});
  const L=pr.last;const wt=$('#w-ptd');
  wt.innerHTML=L?`<p class="xs">\\(\\delta=R+V(S')-V(S)\\)</p>\\[\\delta=-1+${tp(L.nv)}-${tp(L.old)}=${ft(L.d)}\\]\\[V(S)\\leftarrow ${ft(L.old)}+0.5\\,${tp(L.d)}=${ft(L.nw)}\\]`:'<p class="sm muted">Press Step. Orange outline: the cell TD just updated.</p>';typeset(wt);
  const wm=$('#w-pmc');
  if(pr.mcLast&&pr.s===null)wm.innerHTML=`<p class="sm">Episode ended after \\(T=${pr.mcLast.T}\\): every visited cell moved toward its return, e.g. \\(G_0=${-pr.mcLast.T}\\).</p>`;
  else wm.innerHTML=`<p class="sm">Waiting: \\(G_t\\) is unknown until the episode ends. ${pr.buf.length} steps stored, no update yet.</p>`;
  typeset(wm);
  $('#p-info').innerHTML=`Episodes finished: ${pr.ep} · \\(\\alpha=0.5\\) · policy: shortest-path action 90%`;typeset($('#p-info'));
  $('#pPlayBtn').textContent=pr.play?'Pause':'Play';
}
S['s-live']=renderPred;
let pTimer=null;
function pPlayTick(){if(!pr.play||slides[cur].id!=='s-live'){pr.play=false;return;}prStep();renderPred();pTimer=setTimeout(pPlayTick,260);}

/* --- prediction experiment --- */
const PALPHA=[0.05,0.1,0.2,0.5];let pAlpha=0.1,pGust=false,pexpRes=null;
function truePred(gust){const V=new Array(NS).fill(0);const dws=gust?[-1,0,1]:[0];for(let it=0;it<4000;it++)for(const s of STATES){V[s]=pP(s).reduce((t,p,a)=>t+p*dws.reduce((u,dw)=>u+(-1+V[envStep(s,a,dw)])/dws.length,0),0);}
  let d=new Array(NS).fill(0),x=new Array(NS).fill(0);x[START]=1;for(let k=0;k<400;k++){const nx=new Array(NS).fill(0);for(const s of STATES){if(!x[s])continue;d[s]+=x[s];pP(s).forEach((p,a)=>dws.forEach(dw=>nx[envStep(s,a,dw)]+=x[s]*p/dws.length));}x=nx;}
  return {V,set:STATES.filter(s=>d[s]>0.05)};}
const TRUEP={false:truePred(false),true:truePred(true)};
function runPexp(){
  const tp_=TRUEP[pGust],R=20,E=300,td=new Array(E).fill(0),mc=new Array(E).fill(0);
  const rm=V=>Math.sqrt(tp_.set.reduce((t,s)=>t+(V[s]-tp_.V[s])**2,0)/tp_.set.length);
  for(let run=0;run<R;run++){const rnd=mul(1000+run),Vt=new Array(NS).fill(0),Vm=new Array(NS).fill(0);
    for(let e=0;e<E;e++){let s=START;const buf=[];while(s!==GOAL&&buf.length<2000){const a=policyAct(s,rnd);const s2=envStep(s,a,pGust?Math.floor(rnd()*3)-1:0);Vt[s]+=pAlpha*(-1+(s2===GOAL?0:Vt[s2])-Vt[s]);buf.push(s);s=s2;}
      let G=0;for(let i=buf.length-1;i>=0;i--){G-=1;Vm[buf[i]]+=pAlpha*(G-Vm[buf[i]]);}
      td[e]+=rm(Vt)/R;mc[e]+=rm(Vm)/R;}}
  pexpRes={alpha:pAlpha,gust:pGust,td,mc};
}
function optButtons(id,list,curv,act,lab){const el=$(id);el.querySelectorAll('.btn').forEach(b=>b.remove());list.forEach((v,i)=>{const b=document.createElement('button');b.className='btn'+(v===curv?' on':'');b.dataset.do=`${act}:${i}`;b.textContent=lab?lab[i]:String(v);el.appendChild(b);});}
S['s-pexp']=()=>{
  optButtons('#pexp-alpha',PALPHA,pAlpha,'palpha');optButtons('#pexp-wind',[false,true],pGust,'pgust',['steady','gusty']);
  if(!pexpRes)runPexp();
