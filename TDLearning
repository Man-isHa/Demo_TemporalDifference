<style>
:root{
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  --bg:#f3f7fa; --fg:#0f2236; --muted:#5d7083; --line:#cfdbe5; --card:#ffffff;
  --accent:#1f6fb2; --agent:#e4572e;
  --cellbg:#e4edf3; --cell-b:#c6d6e2; --wind:#d6e6f5; --goal:#f2c14e; --goal-fg:#3a2a00; --start:#cfe3f7;
  --cliff:#3a4250; --cliff-fg:#c9d1db; --cost:184,52,60; --good:28,140,96;
  --c1:#1f6fb2; --c2:#e4572e; --c3:#2f9e6e; --c4:#7b5cc4; --c5:#8a96a3;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0c1824; --fg:#e7eff6; --muted:#8ea4b8; --line:#22384c; --card:#12222f;
    --accent:#6fb1ec; --agent:#ff7a52;
    --cellbg:#162a38; --cell-b:#24455a; --wind:#1b3850; --goal:#d9a72d; --goal-fg:#1c1400; --start:#1f4466;
    --cliff:#05090e; --cliff-fg:#7f8fa3; --cost:242,104,110; --good:70,200,140;
    --c1:#6fb1ec; --c2:#ff7a52; --c3:#58cf98; --c4:#b39cf0; --c5:#9aa8b6;
  }
}
:root[data-theme="dark"]{
  --bg:#0c1824; --fg:#e7eff6; --muted:#8ea4b8; --line:#22384c; --card:#12222f;
  --accent:#6fb1ec; --agent:#ff7a52;
  --cellbg:#162a38; --cell-b:#24455a; --wind:#1b3850; --goal:#d9a72d; --goal-fg:#1c1400; --start:#1f4466;
  --cliff:#05090e; --cliff-fg:#7f8fa3; --cost:242,104,110; --good:70,200,140;
  --c1:#6fb1ec; --c2:#ff7a52; --c3:#58cf98; --c4:#b39cf0; --c5:#9aa8b6;
}
*{box-sizing:border-box}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
body{height:100%;margin:0;background:var(--bg);color:var(--fg);font-family:'Public Sans',system-ui,-apple-system,'Segoe UI',sans-serif;overflow:hidden}
#vp{position:relative;width:100%;height:100%;overflow:hidden}
#stage{position:absolute;left:50%;top:50%;width:1600px;height:900px;transform-origin:center center}
.slide{position:absolute;inset:0;padding:48px 80px 96px;display:none;flex-direction:column}
.slide.active{display:flex}
h1{font-family:'Literata',Georgia,serif;font-weight:600;font-size:104px;line-height:1.04;margin:0;letter-spacing:-0.02em}
h2{font-family:'Literata',Georgia,serif;font-weight:600;font-size:52px;line-height:1.1;margin:0 0 24px;letter-spacing:-0.01em}
.tag{font:500 22px 'Public Sans',sans-serif;color:var(--accent);border:2px solid currentColor;border-radius:999px;padding:3px 16px;vertical-align:middle;margin-left:18px;letter-spacing:0}
.row{display:flex;gap:50px;flex:1;min-height:0}
.col{display:flex;flex-direction:column;gap:16px;min-width:0}
.grow{flex:1}.center{justify-content:center}
.txt{font-size:30px;line-height:1.4;margin:0}
.sm{font-size:24px;line-height:1.4;margin:0}
.xs{font-size:19px;line-height:1.4;margin:0;color:var(--muted)}
.muted{color:var(--muted)}
.eq{font-size:34px;line-height:1.2}
.eq mjx-container[display="true"]{margin:6px 0 !important}
.key{font-size:27px;line-height:1.35;border-left:6px solid var(--accent);padding-left:20px}
.ctl{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.btn{font:500 22px 'Public Sans',sans-serif;padding:8px 18px;border-radius:10px;border:1.5px solid var(--line);background:var(--card);color:var(--fg);cursor:pointer;min-width:50px}
.btn:hover{border-color:var(--accent)}
.btn:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.btn.pri{background:var(--accent);border-color:var(--accent);color:#fff}
.btn.on{border-color:var(--agent);box-shadow:inset 0 0 0 2px var(--agent)}
.frag{visibility:hidden}.frag.show{visibility:visible}
/* windy grid */
.wg{display:inline-flex;flex-direction:column;gap:4px}
.grid{display:grid;grid-auto-rows:var(--cs);gap:var(--gp,4px)}
.cell{position:relative;width:var(--cs);border-radius:calc(var(--cs)*.12);background-color:var(--cellbg);box-shadow:inset 0 0 0 1px var(--cell-b);display:flex;align-items:center;justify-content:center;font-family:'JetBrains Mono',ui-monospace,monospace;overflow:hidden;color:var(--fg)}
.cell.windy{background-color:var(--wind)}
.cell.start{background-color:var(--start)}
.cell.goal{background-color:var(--goal);box-shadow:none;color:var(--goal-fg)}
.cell.cliff{background-color:var(--cliff);box-shadow:none;color:var(--cliff-fg)}
.cell .cl{font-size:calc(var(--cs)*.2);font-weight:600;opacity:.85}
.cell::after{content:'';position:absolute;inset:0;border-radius:inherit;pointer-events:none;z-index:4}
.cell.trail::after{box-shadow:inset 0 0 0 3px var(--accent)}
.cell.sel::after{box-shadow:inset 0 0 0 4px var(--agent)}
.cell.onpath::after{box-shadow:inset 0 0 0 3px var(--c3)}
.cell .big{font-size:calc(var(--cs)*.42);font-weight:600;font-family:'Literata',serif}
.cell .st{position:absolute;top:1px;left:4px;font-size:calc(var(--cs)*.22);font-weight:600;font-family:'Literata',serif;color:var(--accent);z-index:3}
.cell .val{font-size:calc(var(--cs)*.25);font-weight:600;position:relative;z-index:2}
.cell .arw{font-size:calc(var(--cs)*.42);font-family:'Public Sans',sans-serif;position:relative;z-index:2}
.cell .disc{position:relative;z-index:2;width:42%;height:42%;border-radius:50%;background:var(--bg);display:flex;align-items:center;justify-content:center;font-size:calc(var(--cs)*.28);font-family:'Public Sans',sans-serif;font-weight:600;box-shadow:0 0 0 1px var(--line);margin-top:-8%}
.cell .qn{position:absolute;bottom:1px;left:0;right:0;text-align:center;font-size:calc(var(--cs)*.21);font-weight:600;z-index:2;text-shadow:0 0 3px var(--bg),0 0 3px var(--bg)}
.cell .pn{position:relative;z-index:2;font-size:calc(var(--cs)*.34);font-weight:600;color:var(--c3)}
.cell .agent{position:absolute;inset:12%;border-radius:50%;border:4px solid var(--agent);background:rgba(228,87,46,.18);z-index:5}
.tri{position:absolute;inset:0;width:100%;height:100%}
.tri polygon{stroke:var(--bg);stroke-width:1.2;vector-effect:non-scaling-stroke}
.windrow{display:grid;gap:var(--gp,4px);font:600 calc(var(--cs)*.26) 'JetBrains Mono',monospace;color:var(--accent);text-align:center}
.windrow span.z{color:var(--muted);font-weight:400}
/* tables & stats */
table.tt{border-collapse:collapse;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:22px}
table.tt th,table.tt td{padding:8px 14px;text-align:center;border-bottom:1px solid var(--line)}
table.tt th{font-family:'Public Sans',sans-serif;font-weight:500;color:var(--muted)}
table.prose td{font-family:'Public Sans',sans-serif;text-align:left;font-size:24px}
table.prose th{text-align:left;font-size:22px}
table.big{font-size:26px}
.stats{display:grid;grid-template-columns:1fr auto;gap:6px 22px;font-size:23px;align-items:baseline}
.stats b{font-family:'JetBrains Mono',monospace;font-size:25px;text-align:right}
.lgd{display:flex;gap:22px;font-size:20px;color:var(--muted);flex-wrap:wrap}
.lgd i{display:inline-block;width:26px;height:4px;border-radius:2px;vertical-align:middle;margin-right:8px}
.lgd i.dash{background:none !important;border-top:3px dashed}
.glab{font-size:22px;color:var(--muted);margin-bottom:6px}
.glab b{color:var(--fg);font-weight:600}
.panel{background:var(--card);border:1.5px solid var(--line);border-radius:14px;padding:14px 18px}
.algo{font-weight:600}
.c-sarsa{color:var(--c1)}.c-q{color:var(--c2)}.c-mc{color:var(--c4)}.c-td{color:var(--c1)}
/* nav */
#nav{position:absolute;left:80px;right:80px;bottom:30px;display:flex;align-items:center;gap:18px}
#bar{flex:1;height:4px;background:var(--line);border-radius:2px;overflow:hidden}
#barfill{height:100%;background:var(--accent);width:0;transition:width .25s}
#cnt{font:500 20px 'JetBrains Mono',monospace;color:var(--muted);min-width:80px;text-align:right}
#nav .btn{padding:4px 16px;font-size:24px}
@media (prefers-reduced-motion: reduce){#barfill{transition:none}}
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <pattern id="hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
    <rect width="8" height="8" style="fill:var(--cellbg)"/>
    <line x1="0" y1="0" x2="0" y2="8" style="stroke:var(--muted);stroke-width:2;opacity:.35"/>
  </pattern>
</defs></svg>
<div id="vp"><div id="stage">

<!-- 1 -->
<section class="slide" id="s-title">
  <div class="col grow center" style="gap:26px">
    <p class="sm muted">Reinforcement learning</p>
    <h1>Temporal-difference<br>learning</h1>
    <p class="txt muted">TD(0), SARSA and Q-learning, compared with Monte Carlo on the windy gridworld</p>
    <div id="g-title" style="margin-top:10px"></div>
  </div>
</section>

<!-- 2 -->
<section class="slide" id="s-world">
  <h2>Sutton–Barto example: windy gridworld</h2>
  <div class="row">
    <div class="col">
      <p class="sm">Wind pushes upward by the indicated number of cells.</p>
      <div id="g-play"></div>
      <div class="ctl">
        <span class="sm muted">Your move</span>
        <button class="btn pri" data-do="play:0">←</button><button class="btn pri" data-do="play:1">↓</button><button class="btn pri" data-do="play:2">→</button><button class="btn pri" data-do="play:3">↑</button>
        <button class="btn" data-do="playReset">Restart</button>
      </div>
    </div>
    <div class="col grow" style="gap:22px">
      <div class="eq">\[R_{t+1}=-1\ \text{per step},\qquad \gamma=1\]</div>
      <p class="sm">Actions \(\leftarrow,\downarrow,\rightarrow,\uparrow\). The wind of the column you start the step in is added to your move. The episode ends at \(G\).</p>
      <div id="play-out" class="key"></div>
      <p class="xs">Reward \(-1\) per step; the agent learns control from interaction. Sutton–Barto, Example 6.5. Keys W A S D also move.</p>
    </div>
  </div>
</section>

<!-- 3 -->
<section class="slide" id="s-opt">
  <h2>The best possible: 15 steps</h2>
  <div class="row">
    <div class="col"><div id="g-opt"></div><p class="xs">Numbers: \(V^*(s)=-(\text{steps to } G)\). Green outline: the optimal path from \(S\).</p></div>
    <div class="col grow center" style="gap:24px">
      <div class="eq">\[V^*(S)=-15\]</div>
      <p class="txt">The shortest route overshoots to the right, then lets the wind and a few moves down bring it to \(G\).</p>
      <p class="sm muted">We computed this with the model. From now on the agent only sees \((S_t,A_t,R_{t+1},S_{t+1})\).</p>
    </div>
  </div>
</section>

<!-- 4 -->
<section class="slide" id="s-tdidea">
  <h2>From Monte Carlo to TD(0)</h2>
  <div class="col grow" style="gap:14px">
    <p class="txt"><span class="algo c-mc">Monte Carlo</span> waits for the full return \(G_t\):</p>
    <div class="eq">\[V(S_t)\leftarrow V(S_t)+\alpha\big[\,G_t-V(S_t)\,\big]\]</div>
    <div class="frag">
      <p class="txt"><span class="algo c-td">TD(0)</span> uses one real step and its own estimate of the rest:</p>
      <div class="eq">\[V(S_t)\leftarrow V(S_t)+\alpha\big[\,R_{t+1}+\gamma V(S_{t+1})-V(S_t)\,\big]\]</div>
    </div>
    <div class="frag">
      <div class="eq">\[\delta_t=R_{t+1}+\gamma V(S_{t+1})-V(S_t)\quad\text{(TD error)}\]</div>
      <p class="sm muted">TD updates after every step, using a guess to update a guess (bootstrapping).</p>
    </div>
  </div>
</section>

<!-- 5 -->
<section class="slide" id="s-live">
  <h2>One episode: TD(0) vs Monte Carlo <span class="tag">prediction</span></h2>
  <div class="ctl" style="margin-bottom:12px">
    <button class="btn pri" data-do="pStep">Step</button>
    <button class="btn pri" id="pPlayBtn" data-do="pPlay">Play</button>
    <button class="btn" data-do="pFinish">Finish episode</button>
    <button class="btn" data-do="pReset">Reset values</button>
    <span class="sm muted" style="margin-left:12px" id="p-info"></span>
  </div>
  <div class="row" style="gap:40px">
    <div class="col" style="gap:10px">
      <div class="glab"><b class="c-td">TD(0)</b>: updates \(V(S_t)\) after every step</div>
      <div id="g-ptd"></div>
      <div id="w-ptd" class="eq" style="font-size:24px"></div>
    </div>
    <div class="col" style="gap:10px">
      <div class="glab"><b class="c-mc">Monte Carlo</b>: updates only when the episode ends</div>
      <div id="g-pmc"></div>
      <div id="w-pmc" class="eq" style="font-size:24px"></div>
    </div>
  </div>
</section>

<!-- 6 -->
<section class="slide" id="s-pexp">
  <h2>Experiment: which predicts faster?</h2>
  <div class="row">
    <div class="col"><canvas id="c-pexp"></canvas><div id="l-pexp" class="lgd"></div></div>
    <div class="col grow" style="gap:16px">
      <div class="ctl" id="pexp-alpha"><span class="sm muted" style="width:70px">\(\alpha\)</span></div>
      <div class="ctl" id="pexp-wind"><span class="sm muted" style="width:70px">wind</span></div>
      <div class="ctl"><button class="btn pri" data-do="pexp">Run 20 runs × 300 episodes</button></div>
      <div id="t-pexp"></div>
      <p class="xs">Policy: the shortest-path action 90% of the time, a random action 10%. Error: RMSE of \(V\) against the true \(V^{\pi}\) over cells the policy visits. Gusty: in windy columns the wind is randomly one more, one less, or as shown.</p>
      <div class="key" style="font-size:23px">Try steady vs gusty wind, and a small vs large \(\alpha\). TD is not always faster; its edge grows with noise.</div>
    </div>
  </div>
</section>

<!-- 7 -->
<section class="slide" id="s-sarsa">
  <h2>SARSA: on-policy TD control</h2>
  <div class="col grow" style="gap:16px">
    <p class="txt">Learn \(Q(s,a)\) instead of \(V(s)\), from each quintuple \((S_t,A_t,R_{t+1},S_{t+1},A_{t+1})\):</p>
    <div class="eq">\[Q(S_t,A_t)\leftarrow Q(S_t,A_t)+\alpha\big[\,R_{t+1}+\gamma\,Q(S_{t+1},A_{t+1})-Q(S_t,A_t)\,\big]\]</div>
    <ol class="sm" style="font-size:28px;line-height:1.6;margin:0;padding-left:40px">
      <li>Choose \(A\) from \(S\) with \(\varepsilon\)-greedy in \(Q\)</li>
      <li>Take \(A\), observe \(R, S'\); choose \(A'\) from \(S'\) with \(\varepsilon\)-greedy in \(Q\)</li>
      <li>Update \(Q(S,A)\); set \(S\leftarrow S',\ A\leftarrow A'\)</li>
    </ol>
    <p class="sm muted">On-policy: the target uses the action \(A'\) the agent will actually take, exploration included.</p>
  </div>
</section>

<!-- 8 -->
<section class="slide" id="s-qlearn">
  <h2>Q-learning: off-policy TD control</h2>
  <div class="col grow" style="gap:16px">
    <div class="eq">\[Q(S_t,A_t)\leftarrow Q(S_t,A_t)+\alpha\big[\,R_{t+1}+\gamma\,\max_{a}Q(S_{t+1},a)-Q(S_t,A_t)\,\big]\]</div>
    <p class="txt">The agent still behaves \(\varepsilon\)-greedily, but the target assumes the best action next.</p>
    <table class="tt big prose" style="margin-top:10px">
      <tr><th>Method</th><th>Target</th><th>Learns about</th></tr>
      <tr><td>Monte Carlo</td><td>\(G_t\)</td><td>the policy followed</td></tr>
      <tr><td>SARSA</td><td>\(R_{t+1}+\gamma\,Q(S_{t+1},A_{t+1})\)</td><td>the \(\varepsilon\)-greedy policy followed</td></tr>
      <tr><td>Q-learning</td><td>\(R_{t+1}+\gamma\,\max_a Q(S_{t+1},a)\)</td><td>the greedy policy, \(q^*\)</td></tr>
    </table>
  </div>
</section>

<!-- 9 -->
<section class="slide" id="s-step">
  <h2>Step through the updates <span class="tag">control</span></h2>
  <div class="row" style="gap:36px">
    <div class="col" style="gap:12px">
      <div class="ctl" id="step-alg"></div>
      <div id="g-step"></div>
      <div class="ctl">
        <button class="btn pri" data-do="sStep:1">Step</button>
        <button class="btn pri" data-do="sStep:10">+10</button>
        <button class="btn pri" data-do="sStep:100">+100</button>
        <button class="btn" data-do="sEp">Finish episode</button>
        <button class="btn" data-do="sReset">Reset</button>
      </div>
    </div>
    <div class="col grow" style="gap:14px">
      <div id="st-step" class="stats"></div>
      <div id="w-step" class="eq" style="font-size:26px"></div>
      <p class="xs">\(\alpha=0.5,\ \varepsilon=0.1,\ \gamma=1\), \(Q=0\) initially. Triangles: \(Q(s,a)\) per direction, darker = more negative; hatched = never updated. Number: \(\max_a Q(s,a)\). Orange outline: the pair just updated.</p>
    </div>
  </div>
</section>

<!-- 10 -->
<section class="slide" id="s-race">
  <h2>Race: how the Q-values change</h2>
  <div class="ctl" style="margin-bottom:14px">
    <button class="btn pri" id="raceBtn" data-do="race">Run</button>
    <span class="sm muted">steps per frame</span>
    <button class="btn" data-do="speed:1">1</button><button class="btn" data-do="speed:10">10</button><button class="btn" data-do="speed:50">50</button>
    <button class="btn" data-do="raceJump">Jump to 8,000 steps</button>
    <button class="btn" data-do="raceReset">Reset</button>
    <span class="sm" style="margin-left:14px">time step <b id="race-t" style="font-family:'JetBrains Mono',monospace"></b></span>
  </div>
  <div style="display:flex;gap:36px" id="race-grids"></div>
  <div class="key" style="margin-top:22px;font-size:24px">All three start from \(Q=0\) and get the same number of steps. TD methods change \(Q\) every step, so a bad policy is fixed mid-episode. Monte Carlo cannot change anything until its episode ends.</div>
</section>

<!-- 11 -->
<section class="slide" id="s-curve">
  <h2>Learning curves</h2>
  <div class="row">
    <div class="col"><canvas id="c-curve"></canvas><div id="l-curve" class="lgd"></div></div>
    <div class="col grow" style="gap:18px">
      <div class="ctl"><button class="btn pri" data-do="raceJump">Run to 8,000 steps</button><button class="btn" data-do="raceNew">New run</button></div>
      <div id="t-curve"></div>
      <p class="sm muted">Slope = episodes per step. A steeper line means shorter episodes. The same run as the race.</p>
    </div>
  </div>
</section>

<!-- 12 -->
<section class="slide" id="s-qs">
  <h2>How \(\max_a Q(S,a)\) evolves at the start</h2>
  <div class="row">
    <div class="col"><canvas id="c-qs"></canvas><div id="l-qs" class="lgd"></div></div>
    <div class="col grow" style="gap:18px">
      <div class="ctl"><button class="btn pri" data-do="raceJump">Run to 8,000 steps</button><button class="btn" data-do="raceNew">New run</button><button class="btn" id="qsZoomBtn" data-do="qsZoom">Show full range</button></div>
      <div id="t-qs"></div>
      <p class="sm"><span class="c-q algo">Q-learning</span> heads to \(q^*\): \(-15\).</p>
      <p class="sm"><span class="c-sarsa algo">SARSA</span> heads to the value of the \(\varepsilon\)-greedy policy it follows, about \(-17\).</p>
      <p class="sm"><span class="c-mc algo">Monte Carlo</span> moves only in jumps, at the end of an episode.</p>
    </div>
  </div>
</section>

<!-- 13 -->
<section class="slide" id="s-paths">
  <h2>Greedy paths after learning</h2>
  <div class="ctl" style="margin-bottom:14px"><button class="btn pri" data-do="raceJump">Run to 8,000 steps</button><button class="btn pri" data-do="raceMore">+8,000 more steps</button><button class="btn" data-do="raceNew">New run</button><span class="sm muted" id="paths-t" style="margin-left:12px"></span></div>
  <div style="display:flex;gap:36px" id="path-grids"></div>
  <p class="sm muted" style="margin-top:18px">Each grid follows \(\arg\max_a Q(s,a)\) from \(S\) with no exploration (optimal: 15 steps). With \(\alpha=0.5\), SARSA's values near \(S\) are noisy and differ by less than one step, so its frozen greedy path can loop even though the learning agent finishes episodes in about 17 steps. Try more steps or a new run.</p>
</section>

<!-- C1 -->
<section class="slide" id="s-cliff">
  <h2>Sutton–Barto example: cliff walking</h2>
  <div class="row">
    <div class="col">
      <div id="g-cplay"></div>
      <div class="ctl">
        <span class="sm muted">Your move</span>
        <button class="btn pri" data-do="cplay:0">←</button><button class="btn pri" data-do="cplay:1">↓</button><button class="btn pri" data-do="cplay:2">→</button><button class="btn pri" data-do="cplay:3">↑</button>
        <button class="btn" data-do="cplayReset">Restart</button>
      </div>
    </div>
    <div class="col grow" style="gap:20px">
      <div class="eq">\[R=\begin{cases}-100 & \text{cliff}\\ -1 & \text{otherwise}\end{cases}\quad\gamma=1\]</div>
