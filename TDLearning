function cpMove(a){if(cp.s===CG)return;const o=cStep(cp.s,a);cp.n++;cp.ret+=o.r;cp.s=o.s2;cp.trail.add(o.s2);cp.fell=o.fell?o.hit:null;
  cp.msg=o.fell?'You fell: \\(-100\\) and back to \\(S\\).':`You chose \\(${ATEX[a]}\\): \\(-1\\).`;
