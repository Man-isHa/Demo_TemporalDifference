/* ================= cliff walking ================= */
const CW=12,CH=4,CN=48,CS=36,CG=47;const isCliff=s=>s>36&&s<47;
function cStep(s,a){const r=clamp(Math.floor(s/CW)+DR[a][0],0,CH-1),c=clamp(s%CW+DR[a][1],0,CW-1),s2=r*CW+c;if(isCliff(s2))return {s2:CS,r:-100,fell:true,hit:s2};return {s2,r:-1,fell:false};}
function gridC(o={}){
  const cs=o.cell||54,sc=o.scale||40;
  let h=`<div class="wg" style="--cs:${cs}px;--gp:4px"><div class="grid" style="grid-template-columns:repeat(${CW},var(--cs))">`;
  for(let s=0;s<CN;s++){
    let cls='cell'+(s===CG?' goal':s===CS?' start':isCliff(s)?' cliff':'');
    if(o.trail&&o.trail.has(s))cls+=' trail';
    if(o.path&&o.path.has(s))cls+=' onpath';
    if(o.sel===s)cls+=' sel';
    if(o.fell===s)cls+=' sel';
    if(o.click&&!isCliff(s)&&s!==CG)cls+=' click';
    let inner='';
    if(s===CG)inner=`<span class="big">G</span>`;
    else if(isCliff(s))inner=`<span class="cl">−100</span>`;
    else{
      if(o.Q){
        const q=o.Q[s],n=o.N?o.N[s]:null;
        inner+=`<span class="st">${s===CS?'S':''}</span><svg class="tri" viewBox="0 0 100 100" preserveAspectRatio="none">${TRI.map((p,a)=>`<polygon points="${p}" style="${n&&!n[a]?'fill:url(#hatch)':cfill(q[a],sc)}"/>`).join('')}</svg>`;
        if(o.path&&o.path.has(s))inner+=`<span class="disc">${o.path.get(s)}</span>`;
        else if(!allEq(q))inner+=`<span class="disc">${ARW[greedyD(q)]}</span>`;
      }else if(s===CS)inner+=`<span class="big" style="color:var(--accent)">S</span>`;
    }
    if(o.agent===s)inner+=`<span class="agent"></span>`;
    h+=`<div class="${cls}" data-s="${s}">${inner}</div>`;
  }
  return h+'</div></div>';
}
