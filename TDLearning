    if(L.done){const e=L.ex;return `<p class="sm">Episode ended after \\(T=${L.T}\\) steps. All ${L.m} first-visited pairs updated at once with \\(G_t=-(T-t)\\), e.g.</p>\\[Q(S_0,${ATEX[e.a]})\\leftarrow ${ft(e.old)}+\\tfrac{1}{${e.N}}\\big(${e.G}-${tp(e.old)}\\big)=${ft(e.nw)}\\]`;}
