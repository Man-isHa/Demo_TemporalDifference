/* --- control agents --- */
function mkAgent(alg,seed){return {alg,rnd:mul(seed),Q:newQ(),N:newQ(),s:null,a:null,t:0,eps:0,epLen:0,buf:[],trail:new Set(),hist:[[0,0,0]],lens:[],last:null};}
function agentStep(g){
  if(g.s===null){g.s=START;g.a=eg(g.Q,START,g.rnd);g.epLen=0;g.buf=[];g.trail=new Set([START]);}
  const s=g.s,a=g.a,s2=envStep(s,a),r=-1;g.t++;g.epLen++;g.trail.add(s2);
  const info={s,a,r,s2,alg:g.alg};
  if(g.alg==='mc'){
    g.buf.push([s,a]);
    if(s2===GOAL){const T=g.buf.length,first=new Map();g.buf.forEach(([x,y],t)=>{const k=x*4+y;if(!first.has(k))first.set(k,t);});
      for(const [k,t] of first){const x=k>>2,y=k&3,G=-(T-t),old=g.Q[x][y];g.N[x][y]++;g.Q[x][y]+=(G-old)/g.N[x][y];if(t===0)info.ex={old,G,N:g.N[x][y],nw:g.Q[x][y],s:x,a:y};}
      info.T=T;info.m=first.size;}
    else info.wait=g.buf.length;
  }else{
    const a2=s2===GOAL?null:eg(g.Q,s2,g.rnd),old=g.Q[s][a];
    const nxt=s2===GOAL?0:(g.alg==='sarsa'?g.Q[s2][a2]:Math.max(...g.Q[s2]));
    const tgt=r+nxt;g.Q[s][a]=old+ALPHA*(tgt-old);g.N[s][a]++;Object.assign(info,{a2,old,nxt,tgt,nw:g.Q[s][a]});
  }
  if(s2===GOAL){g.eps++;g.lens.push(g.epLen);g.s=null;info.done=true;}
  else{g.s=s2;g.a=g.alg==='sarsa'?info.a2:eg(g.Q,s2,g.rnd);}
  if(g.t%20===0||info.done)g.hist.push([g.t,g.eps,Math.max(...g.Q[START])]);
  g.last=info;return info;
}
const ALGS=[['sarsa','SARSA','--c1','c-sarsa'],['q','Q-learning','--c2','c-q'],['mc','Monte Carlo','--c4','c-mc']];
